# Imgur API Configuration
IMGUR_CLIENT_ID=your_imgur_client_id_here

# Ollama Configuration (for vision model)
OLLAMA_HOST=http://localhost:11434
VISION_MODEL=qwen3-vl

# LLM Configuration
LLM_MODEL=llama3.1
# Optional: Custom LLM endpoint (will be provided by user)
# LLM_ENDPOINT=http://your-custom-llm-endpoint:port/api
# LLM_API_KEY=your_api_key_if_needed

# ComfyUI Configuration
COMFYUI_HOST=http://localhost:8188
# Optional: Custom ComfyUI API endpoint (will be provided by user)
# COMFYUI_API_ENDPOINT=http://your-comfyui-endpoint:port/api
